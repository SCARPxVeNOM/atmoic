{
  "name": "atomic-perps-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Liquidator, oracle relay, and REST/WS API for Atomic Perps",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "liquidator": "ts-node-dev --transpile-only src/services/liquidator.ts",
    "oracle-relay": "ts-node-dev --transpile-only src/services/oracle-relay.ts",
    "api": "ts-node-dev --transpile-only src/services/api.ts",
    "calibrate": "ts-node --transpile-only scripts/calibrate-volatility.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@kamino-finance/klend-sdk": "^7.3.22",
    "@pythnetwork/pyth-solana-receiver": "^0.9.0",
    "@solana/spl-token": "^0.4.6",
    "@solana/web3.js": "^1.95.0",
    "bn.js": "^5.2.1",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pino": "^9.2.0",
    "pino-pretty": "^13.1.3",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
