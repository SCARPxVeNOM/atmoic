# Copy to backend/.env and fill in values. NEVER commit .env.

# Solana RPC — use a paid endpoint (Helius, Triton, QuickNode) for liquidator reliability.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Deployed atomic_perps program ID (update after anchor deploy).
ATOMIC_PERPS_PROGRAM_ID=

# Keypair path for liquidator / oracle-relay wallet (base58 secret or JSON array file).
LIQUIDATOR_KEYPAIR_PATH=C:\Users\aryan\.config\solana\id.json

# Pyth Hermes endpoint — free, no auth. Used by oracle-relay at runtime.
HERMES_URL=https://hermes.pyth.network

# Pyth Pro API key — DEV-TIME ONLY. Used by scripts/calibrate-volatility.ts.
# Do NOT reference this at runtime (trial expires 2026-04-17, plus no-redistribute clause).
PYTH_PRO_API_KEY=

# API server
API_PORT=3001

# Liquidator tuning
LIQUIDATOR_POLL_MS=10000
ORACLE_RELAY_POLL_MS=2000

# Dependency monitor — how often to check external program upgrades (ms)
DEP_MONITOR_POLL_MS=300000

# Circuit breaker — SOL drop threshold in bps to trigger auto-pause (1500 = 15%)
CIRCUIT_BREAKER_THRESHOLD_BPS=1500

# Address Lookup Table — deployed via scripts/alt-setup.ts (solves F-01 account limit)
ALT_ADDRESS=

# Crank service — redundant RPC endpoints for execute_batch submission
CRANK_RPC_1=
CRANK_RPC_2=
CRANK_RPC_3=

# Jito tip in lamports for priority inclusion (default 1000 = 0.000001 SOL)
JITO_TIP_LAMPORTS=1000

# Jito BAM — bundle submission for priority execution (B-03, M-5)
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_BUNDLE_ENABLED=false

# Alert webhook (Slack/Discord) for circuit breaker and dependency monitor alerts
ALERT_WEBHOOK_URL=

# PagerDuty integration key for critical alerts
PAGERDUTY_KEY=
